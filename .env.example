# Copia in .env (non committare). Le chiavi restano solo sul backend.

# Provider di default: xAI / Grok, API compatibile OpenAI.
# Documentazione: https://docs.x.ai
XAI_API_KEY=
DEFAULT_LLM_PROVIDER=xai
DEFAULT_LLM_MODEL=grok-4.7

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Server locale compatibile con le API OpenAI (Ollama: http://127.0.0.1:11434/v1).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# Trascrizione. Senza questa chiave si usa il riconoscimento vocale del browser.
DEEPGRAM_API_KEY=

# Cadenza dell'analisi sul transcript (fine frase + intervallo minimo).
ANALYSIS_MIN_INTERVAL=20
ANALYSIS_MIN_CHARS=80
